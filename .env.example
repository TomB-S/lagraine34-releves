# Example values only, nothing sensitive.
#
# The server does NOT read any .env file. Export these variables in the
# shell before starting it, or put them in front of the command:
#   export CYCLOS_BASE_URL=https://cyclos.example.org/api
#   CYCLOS_BASE_URL=https://cyclos.example.org/api PORT=8080 npm start
# Every variable is optional; the defaults are in README.md.

# Address of the Cyclos API (with /api). Default: the public Cyclos demo.
CYCLOS_BASE_URL=https://cyclos.example.org/api

# Cyclos channel, sent in the Channel header. Letters, digits, - and _,
# 32 characters at most. Leave empty to send no header.
CYCLOS_CHANNEL=

# Listening port.
PORT=3000

# Session closed after this many minutes without activity.
SESSION_IDLE_MINUTES=20

# Session closed after this many hours, whatever the activity.
SESSION_MAX_HOURS=8

# true only behind HTTPS (Secure cookie + HSTS).
COOKIE_SECURE=false

# Lines requested from Cyclos per page, and maximum lines in the detail.
HISTORY_PAGE_SIZE=200
HISTORY_MAX_ROWS=2000
