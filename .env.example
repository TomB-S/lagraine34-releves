# Example values only, nothing sensitive.
#
# Copy this file to .env (cp .env.example .env) and edit the copy.
# - "npm start" reads .env if it exists (Node option --env-file-if-exists,
#   Node 22.9 or later). Without .env, nothing changes.
# - "node server.js" alone does NOT read .env; neither does "npm test".
# - A variable set in front of the command, or exported in the shell, wins
#   over the same variable in .env, even if empty:
#     PORT=8080 npm start
# - .env is ignored by git. Never commit it.
# Every variable is optional; the defaults are in README.md.

# Address of the Cyclos API (with /api). Without this line the tool targets
# the public Cyclos DEMO (https://demo.cyclos.org/api), not the real instance.
# For real use, uncomment the line and put the address of the real instance:
# CYCLOS_BASE_URL=https://REAL-INSTANCE-ADDRESS/api

# Cyclos channel, sent in the Channel header. Letters, digits, - and _,
# 32 characters at most. Leave empty to send no header.
# Use "main" for professional accounts (without it, Cyclos answers 403/404).
CYCLOS_CHANNEL=main

# Listening port.
PORT=3000

# Session closed after this many minutes without activity.
SESSION_IDLE_MINUTES=20

# Session closed after this many hours, whatever the activity.
SESSION_MAX_HOURS=8

# true only behind HTTPS (Secure cookie + HSTS).
COOKIE_SECURE=false

# Lines requested from Cyclos per page, and maximum lines in the detail.
HISTORY_PAGE_SIZE=200
HISTORY_MAX_ROWS=2000
